{
  "name": "fairybiome",
  "version": "0.20.0-next",
  "private": true,
  "type": "module",
  "browserslist": [
    ">0.25%",
    "not dead"
  ],
  "scripts": {
    "build:workers": "node scripts/buildWorkers.mjs",
    "dump:episode-matrix": "node scripts/dumpEpisodeMatrix.mjs",
    "sync:static": "node scripts/syncStatic.mjs",
    "predev": "npm run build:workers && npm run sync:static",
    "dev": "next dev --turbo",
    "prebuild": "npm run build:workers && npm run sync:static",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "setup:content": "node scripts/uploadContentToFirestore.js"
  },
  "dependencies": {
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@firebase-oss/ui-styles": "^7.1.0",
    "dexie": "^4.4.6",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.50.0",
    "mathjs": "^15.2.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "string-replace-async": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
