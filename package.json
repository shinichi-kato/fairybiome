{
  "name": "fairybiome",
  "version": "0.38.2",
  "private": true,
  "type": "module",
  "browserslist": [
    ">0.25%",
    "not dead"
  ],
  "scripts": {
    "build:workers": "node scripts/buildWorkers.mjs",
    "dump:episode-matrix": "node scripts/dumpEpisodeMatrix.mjs",
    "sync:static": "node scripts/syncStatic.mjs",
    "predev": "npm run build:workers && npm run sync:static",
    "dev": "next dev --turbo",
    "prebuild": "npm run build:workers && npm run sync:static",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "setup:content": "node scripts/uploadContentToFirestore.js"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.63.0",
    "mathjs": "^15.2.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "string-replace-async": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
